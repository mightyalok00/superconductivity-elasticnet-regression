# Optional runtime settings
SC_APP_ENV=production
SC_HOST=0.0.0.0
SC_PORT=8000

# Portable project paths are used by default.
# Override only when needed:
# SC_TRAIN_PATH=/absolute/path/to/train.csv
# SC_UNIQUE_PATH=/absolute/path/to/unique_m.csv
# SC_MODEL_PATH=/absolute/path/to/elasticnet_v1.joblib
# SC_METADATA_PATH=/absolute/path/to/model_metadata.json

# Public demo defaults
SC_CORS_ORIGINS=*
SC_ENABLE_RATE_LIMIT=false
SC_REQUESTS_PER_MINUTE=120
SC_REQUIRE_API_KEY=false
# SC_API_KEY=replace-me
